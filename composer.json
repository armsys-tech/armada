{
    "name": "armsys-tech/armada",
    "description": "Blade and Livewire UI components for Laravel: light/dark themes, mobile-first, no Tailwind required.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "livewire",
        "blade",
        "ui",
        "components",
        "design-system",
        "alpine",
        "dark-mode",
        "mobile-first"
    ],
    "homepage": "https://github.com/armsys-tech/armada",
    "support": {
        "issues": "https://github.com/armsys-tech/armada/issues",
        "source": "https://github.com/armsys-tech/armada"
    },
    "authors": [
        {
            "name": "Armsys Technology",
            "homepage": "https://github.com/armsys-tech"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/view": "^12.0|^13.0"
    },
    "suggest": {
        "livewire/livewire": "^3.0|^4.0 for wire:model, loading states and server-side toasts"
    },
    "autoload": {
        "psr-4": {
            "Armada\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Armada\\ArmadaServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
