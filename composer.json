{
    "name": "armsys-tech/armada",
    "description": "Blade and Livewire UI components for Laravel: light/dark themes, mobile-first, no Tailwind required.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "livewire", "blade", "ui", "components", "design-system"],
    "authors": [{ "name": "Armsys Technology" }],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/view": "^12.0|^13.0"
    },
    "suggest": {
        "livewire/livewire": "wire:model, loading states and server-side toasts"
    },
    "autoload": {
        "psr-4": { "Armada\\": "src/" }
    },
    "extra": {
        "laravel": {
            "providers": ["Armada\\ArmadaServiceProvider"]
        }
    },
    "minimum-stability": "stable"
}
